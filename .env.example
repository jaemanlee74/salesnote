# 복사해서 .env로 저장한 뒤 값을 바꿉니다. .env는 저장소에 올리지 않습니다.

# --- MySQL ---
MYSQL_DATABASE=salesnote
MYSQL_USER=salesnote
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- 웹 ---
# 세션 쿠키 서명 키. 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# 사용자가 접속하는 주소. 구글 로그인 리디렉션 주소와 알림 링크에 쓰입니다.
BASE_URL=http://localhost:8000
WEB_PORT=8000
# HTTPS로 서비스할 때 true (운영에서는 반드시 true)
COOKIE_SECURE=false

# --- 구글 로그인 ---
# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: {BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 최초 관리자 구글 계정(쉼표로 구분). 시작할 때 허용 사용자로 등록됩니다.
ADMIN_EMAILS=admin@example.com

# 개발용 로그인(메일만 입력해 로그인). 운영에서는 반드시 false
DEV_LOGIN=false

# --- 메일 알림(선택). 비워 두면 메일을 보내지 않습니다 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
